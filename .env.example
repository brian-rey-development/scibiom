# Postgres container (read by docker compose)
POSTGRES_PASSWORD=local-dev-only-postgres
SCIBIOM_OWNER_PASSWORD=local-dev-only-owner
SCIBIOM_APP_PASSWORD=local-dev-only-app

# API
SCIBIOM_ENVIRONMENT=local
SCIBIOM_DATABASE__URL=postgresql+psycopg://scibiom_app:local-dev-only-app@127.0.0.1:5432/scibiom
SCIBIOM_MIGRATION_DATABASE_URL=postgresql+psycopg://scibiom_owner:local-dev-only-owner@127.0.0.1:5432/scibiom
SCIBIOM_CORS__ALLOWED_ORIGINS=["http://localhost:3000"]
SCIBIOM_IDENTITY__SECRET=local-dev-only-identity-secret-0123456789abcdef
SCIBIOM_EMAIL__HOST=127.0.0.1
SCIBIOM_EMAIL__PORT=1025
SCIBIOM_EMAIL__SENDER=no-reply@scibiom.localhost

# Web (inlined into the browser bundle at build time)
VITE_SCIBIOM_API_URL=http://localhost:8000
