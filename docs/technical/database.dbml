Project scibiom {
  database_type: 'PostgreSQL'
  Note: '''
    Current schema only. Add each table in the same change as its migration.

    Conventions for every bounded context
    - One Postgres schema per context, named after the context.
    - No foreign keys across schemas.
    - Primary keys are UUIDv7 values generated in Python with uuid.uuid7().
    - Tenant-owned rows carry workspace_id.

    Roles
    - scibiom_owner owns the database and every schema, and runs migrations.
    - scibiom_app reads and writes rows only in schemas whose migration grants it access, and cannot change the schema.
    - scibiom_app has no privileges on the alembic schema.
  '''
}

Table alembic.alembic_version {
  version_num varchar(32) [pk, not null]

  Note: 'Migration state. Created by Alembic in a schema env.py creates as scibiom_owner.'
}

Table identity.accounts {
  id uuid [pk, not null]
  workspace_id uuid [unique, not null]
  email text [unique, not null, note: 'Trimmed and lowercased, enforced by a check constraint.']
  created_at timestamptz [not null]

  Note: 'A registered person and the personal workspace they own.'
}

Table identity.sessions {
  id uuid [pk, not null]
  account_id uuid [not null]
  token_hash bytea [unique, not null, note: 'SHA-256 of the session token, 32 bytes.']
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'Fixed 14 days after created_at, never renewed.']

  indexes {
    account_id
    expires_at
  }

  Note: 'Opaque server-side sessions. Revoking a session deletes its row.'
}

Table identity.auth_challenges {
  id uuid [pk, not null]
  email text [not null, note: 'Trimmed and lowercased, enforced by a check constraint.']
  code_mac bytea [not null, note: 'HMAC-SHA256 of the code, 32 bytes.']
  attempts_left smallint [not null, note: 'Between 0 and 3.']
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'After created_at.']
  consumed_at timestamptz [note: 'A challenge is never both consumed and invalidated.']
  invalidated_at timestamptz

  indexes {
    (email, created_at)
    expires_at
    email [unique, note: 'Partial, only where consumed_at and invalidated_at are null, so an address has at most one active challenge']
  }

  Note: 'One-time email codes for signing in. No foreign keys, because a challenge exists before its account does.'
}

Ref: identity.sessions.account_id > identity.accounts.id [delete: cascade]
