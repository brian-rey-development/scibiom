{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "generate:api": "pnpm --filter openapi-codegen generate && oxfmt src/core/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "^5.108.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
